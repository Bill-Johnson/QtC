# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Data and user files — never commit user mail or config
data/
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Release tarballs — upload to GitHub Releases, not the repo
*.tar.gz
*.zip

# Test/scratch files
scratch/
test_*.py
# ...but the QA harness IS tracked. It is development-only (excluded from
# the release tarball and QtC.spec), and without this exception the blanket
# test_*.py rule above silently drops every harness.
!tests/
!tests/test_*.py
!tests/run_all.py
CLAUDE.md
